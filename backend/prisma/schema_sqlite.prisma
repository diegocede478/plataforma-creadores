// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// USER & AUTHENTICATION
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          Role     @default(FAN)
  avatar        String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  posts           Post[]
  services        Service[]
  subscriptions   Subscription[]  @relation("UserSubscriptions")
  subscribers     Subscription[]  @relation("UserSubscribers")
  sentMessages    Message[]       @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageReceiver")
  wallet          Wallet?
  ordersAsFan     Order[]         @relation("OrderFan")
  ordersAsCreator Order[]         @relation("OrderCreator")

  @@map("users")
}

enum Role {
  CREATOR
  FAN
}

// ─────────────────────────────────────────────────────────────
// POSTS (OnlyFans-style content)
// ─────────────────────────────────────────────────────────────

model Post {
  id          String   @id @default(cuid())
  creatorId   String
  content     String
  mediaUrl    String?
  isPremium   Boolean  @default(false)
  price       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

// ─────────────────────────────────────────────────────────────
// SERVICES / GIGS (Fiverr-style offerings)
// ─────────────────────────────────────────────────────────────

model Service {
  id            String        @id @default(cuid())
  creatorId     String
  title         String
  description   String
  price         Decimal       @db.Decimal(10, 2)
  deliveryDays  Int
  status        ServiceStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  creator       User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("services")
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  DELETED
}

// ─────────────────────────────────────────────────────────────
// ORDERS (Gig purchases)
// ─────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  serviceId   String
  fanId       String
  creatorId   String
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fan         User        @relation("OrderFan", fields: [fanId], references: [id], onDelete: Cascade)
  creator     User        @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("orders")
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(cuid())
  fanId     String
  creatorId String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime

  fan       User               @relation("UserSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creator   User               @relation("UserSubscribers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([fanId, creatorId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────
// MESSAGES (Chat between users)
// ─────────────────────────────────────────────────────────────

model Message {
  id           String   @id @default(cuid())
  senderId     String
  receiverId   String
  content      String
  isPaid       Boolean  @default(false)
  price        Decimal? @db.Decimal(10, 2)
  isUnlocked   Boolean  @default(false)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  sender       User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// WALLET & TRANSACTIONS
// ─────────────────────────────────────────────────────────────

model Wallet {
  id        String        @id @default(cuid())
  userId    String        @unique
  balance   Decimal       @default(0) @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  referenceId String?
  createdAt   DateTime        @default(now())

  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  TIP
  SERVICE_PURCHASE
  SERVICE_PAYMENT
}
